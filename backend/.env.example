# Copie para .env e preencha. NUNCA versione o arquivo .env.
PORT=3333
NODE_ENV=development

# Conexão com o PostgreSQL (o mesmo servidor que aparece no pgAdmin 4)
PGHOST=localhost
PGPORT=5432
PGDATABASE=banco_memorix
PGUSER=postgres
PGPASSWORD=coloque_sua_senha_aqui

# Origens autorizadas no CORS (separadas por vírgula). Use * apenas em rede local de testes.
CORS_ORIGIN=http://localhost:5173

# Limite de requisições por minuto, por IP
RATE_LIMIT_PER_MINUTE=600
